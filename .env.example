#DATABASE_HOST=localhost
#DATABASE_USERNAME=username
#DATABASE_PASSWORD=password
#DATABASE_DB=despachante_db
#DATABASE_PORT=3306

# ==================== CONFIGURAÇÃO DE EMAIL ====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app-google
MAIL_FROM=seu-email@gmail.com
MAIL_FROM_NAME="Sistema de Notificações"

# ==================== CONFIGURAÇÃO DE FRONTEND ====================
FRONTEND_URL=http://localhost:3000

# ==================== CONFIGURAÇÃO DE CRON JOBS ====================
# Formato: "minuto hora dia-mes dia-semana"
# Padrão: segunda-feira às 9h
# Use https://crontab.guru para customizar

CRON_VERIFICAR_NOTIFICACOES=0 9 * * 1
CRON_ENVIAR_EMAILS=0 9 * * 1

# ==================== CONFIGURAÇÃO DE NOTIFICAÇÃO ====================
# Quantos dias antes avisar
DIAS_AVISO_CNH=30
DIAS_AVISO_LICENCIAMENTO=30

# ==================== GUIA: CONFIGURAR EMAIL COM GMAIL ====================
# 
# 1. Acesse: https://myaccount.google.com
# 2. Vá para "Segurança"
# 3. Ative "Verificação em duas etapas"
# 4. Acesse: https://myaccount.google.com/apppasswords
# 5. Selecione: "Correio" e "Windows Computer" (ou seu dispositivo)
# 6. Copie a senha gerada (16 caracteres)
# 7. Cole em: MAIL_PASSWORD acima
#
# Não use sua senha do Gmail, use a senha de app!
#