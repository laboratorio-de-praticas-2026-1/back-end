{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": ["@nestjs/swagger"],
    "assets": [
      "infra/email/templates/**/*",
      "modules/reports/templates/**/*.ejs",
      "static/**/*"
    ],
    "watchAssets": true
  }
}
