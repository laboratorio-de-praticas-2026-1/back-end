<div style="font-family: Arial, sans-serif;">

  <!-- LOGO -->
  <img src="cid:logo_img" alt="Logo" style="max-width:200px; margin-bottom:20px;" />

  <h1>Novo contato</h1>

  <p><b>Nome:</b> <%= nome %></p>
  <p><b>Email:</b> <%= email %></p>

  <% if (telefone) { %>
    <p><b>Telefone:</b> <%= telefone %></p>
  <% } %>

  <p><b>Assunto:</b> <%= assunto %></p>
  <p><b>Mensagem:</b><br/><%= mensagem %></p>

</div>